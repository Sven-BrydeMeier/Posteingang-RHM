# Streamlit Secrets Konfiguration
# Diese Datei dient als Beispiel. Kopieren Sie sie zu "secrets.toml" und tragen Sie Ihre echten Keys ein.
# WICHTIG: secrets.toml niemals in Git committen!

# =============================================================================
# API KEYS FÜR KI-ANALYSE
# =============================================================================

# Option 1: Verschachtelte Struktur (empfohlen)
[openai]
api_key = "sk-..."

[claude]
api_key = "sk-ant-..."

[gemini]
api_key = "AIza..."

# Option 2: Flache Struktur (wird auch unterstützt)
# OPENAI_API_KEY = "sk-..."
# ANTHROPIC_API_KEY = "sk-ant-..."
# GOOGLE_API_KEY = "AIza..."

# =============================================================================
# EMAIL-VERSAND (SMTP) FÜR POSTEINGANG-VERTEILUNG
# =============================================================================

[smtp]
# SMTP-Server Einstellungen
server = "smtp.office365.com"  # oder "smtp.gmail.com"
port = 587
user = "posteingang@ra-rhm.de"
password = "IhrSicheresPasswort"

# Absender-Name (optional)
sender_name = "RHM Posteingang"
